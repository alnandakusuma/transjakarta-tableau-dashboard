      <aliases enabled='yes' />
      <column caption='Trip Duration (min)' datatype='integer' name='[Calculation_1612488623722496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([tapOutTime]) AND [tapOutTime] &gt;= [tapInTime] THEN DATEDIFF(&apos;minute&apos;,[tapInTime],[tapOutTime]) END' />
      </column>
      <column aggregation='Sum' caption='Hour of Day' datatype='integer' name='[Calculation_1612488623869953]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[tapInTime])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1612488623964162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[tapInTime])' />
      </column>
      <column caption='Day Type' datatype='string' name='[Calculation_1612488624029699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[tapInTime]) = 1 OR DATEPART(&apos;weekday&apos;,[tapInTime]) = 7 THEN &apos;Weekend&apos; ELSE &apos;Weekday&apos; END' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1612488624279556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='2023 - [payCardBirthDate]' />
      </column>
      <column caption='Trips' datatype='integer' name='[Calculation_1612488624361477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([transID])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1612488624558086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1612488624279556] &lt; 20 THEN &apos;&lt;20&apos; ELSEIF [Calculation_1612488624279556] &lt; 30 THEN &apos;20-29&apos; ELSEIF [Calculation_1612488624279556] &lt; 40 THEN &apos;30-39&apos; ELSEIF [Calculation_1612488624279556] &lt; 50 THEN &apos;40-49&apos; ELSEIF [Calculation_1612488624279556] &lt; 60 THEN &apos;50-59&apos; ELSE &apos;60+&apos; END' />
      </column>
      <column caption='Missing Tap-Out %' datatype='real' name='[Calculation_1612488624930823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([tapOutTime]) THEN 1 ELSE 0 END) / COUNT([transID])' />
      </column>
      <column caption='Avg Fare per Trip' datatype='real' name='[Calculation_1612488625119240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payAmount]) / [Calculation_1612488624361477]' />
      </column>
      <column caption='dfTransjakarta180kRows.csv' datatype='table' name='[__tableau_internal_object_id__].[dfTransjakarta180kRows.csv_B5B16D708D34427E8079F248BED9C15C]' role='measure' type='quantitative' />
      <column caption='Corridor ID' datatype='string' name='[corridorID]' role='dimension' type='nominal' />
      <column caption='Corridor' datatype='string' name='[corridorName]' role='dimension' type='nominal' />
      <column caption='Direction' datatype='string' name='[direction]' role='dimension' type='nominal' />
      <column caption='Fare' datatype='real' name='[payAmount]' role='measure' type='quantitative' />
      <column caption='Bank' datatype='string' name='[payCardBank]' role='dimension' type='nominal' />
      <column caption='Birth Year' datatype='integer' name='[payCardBirthDate]' role='measure' type='quantitative' />
      <column caption='Pay Card ID' datatype='integer' hidden='true' name='[payCardID]' role='dimension' type='ordinal' />
      <column caption='Pay Card Name' datatype='string' hidden='true' name='[payCardName]' role='dimension' type='nominal' />
      <column caption='Gender' datatype='string' name='[payCardSex]' role='dimension' type='nominal' />
      <column caption='Stop End Seq' datatype='real' name='[stopEndSeq]' role='measure' type='quantitative' />
